# =====================================================================
# GLM-5.3 FP8 · PP2 × TP8 · 两台 8×RTX PRO 6000 —— 集群配置
# 两台机器使用同一份文件（改完同步到另一台），所有脚本都从这里读。
# 注意：值里不要出现 # 号。
# =====================================================================

# ---------------- 网络 ----------------
NODE0_ADDR=10.0.0.1          # 节点0 在 RDMA 网段上的 IP；HTTP 服务也在节点0
NODE1_ADDR=10.0.0.2          # 节点1 在 RDMA 网段上的 IP（互相 ping、防火墙放行用）
DIST_PORT=20000              # 分布式初始化端口；NCCL 测试用 DIST_PORT+100。两台之间要放通
NET_IFNAME=ens1f0np0         # 与 NODE0_ADDR 同网段的网卡名（ip -br addr 查看；IB 一般是 ib0）
IB_HCA=mlx5_0                # RDMA 设备名（ibv_devices 或 ibdev2netdev 查看）
IB_PORT=1                    # RDMA 端口号，一般是 1
IB_GID_INDEX=                # IB 留空即可；RoCE 留空默认用 3，preflight 会列出可用的 RoCE v2 GID
LINE_RATE_GBPS=400           # 网卡线速（Gb/s），NCCL 测试据此判断带宽是否正常

# ---------------- 模型与服务 ----------------
MODEL_PATH=/home/test/ext_module/GLM-5.3   # zai-org/GLM-5.3（默认即 FP8）。两台机器必须是同一路径、同一份文件
SERVED_NAME=glm-5.3
HTTP_PORT=30000
API_KEY=                     # 强烈建议设置；留空则不鉴权

# ---------------- serve 模式参数 ----------------
ATTN_MODE=dense              # dense：flashinfer 稠密 MLA，社区在 SM120 上跑通 GLM-5 的路径（默认）
                             # dsa  ：交给 SGLang 自动选 DSA 稀疏注意力后端（SM120 上目前大概率起不来）
CONTEXT_LENGTH=131072        # 单请求最大上下文
MAX_RUNNING=32               # 同时在跑的请求上限
CHUNKED_PREFILL=16384        # prefill 分块大小（也是 PP 的微批粒度）
MEM_FRACTION=0.85            # 每卡静态显存比例（权重 + KV 池）；OOM 先降到 0.80
CUDA_GRAPH_MAX_BS=32         # CUDA Graph 覆盖的最大 batch
PP_LAYER_PARTITION=          # 两级各放多少层，如 40,38；留空则 39/39 均分
ENABLE_MTP=0                 # PP 下的 MTP 没有公开验证，先跑稳再试 1

# ---------------- 裸机 Python 环境 ----------------
# deploy.sh --container 会忽略 PY_ENV 和 CUDA_HOME，用镜像自带的；手动进容器运行脚本时请把 PY_ENV 留空
PY_ENV=/opt/glm53-venv       # SGLang 所在的虚拟环境：目录或其 bin/activate，如 /home/test/sglang_env/bin/activate
                             # 已有环境直接填；不存在时 install_env.sh 会在这里创建。其它脚本会自动激活
PY_VERSION=3.12
SGLANG_VERSION=              # 留空装最新版；install_env.sh 会生成 requirements.lock，保证两台完全一致
CUDA_HOME=                   # CUDA Toolkit 路径，如 /usr/local/cuda-12.9；flashinfer 首次 JIT 编译需要 nvcc

# ---------------- 容器部署（deploy.sh --container）----------------
CONTAINER_IMAGE=lmsysorg/sglang:latest   # SM120 上跑不通时可换社区补丁镜像，见 README
